#!/usr/bin/env bash
# quorum: a council of models for an implementer. Advisors answer independently in disposable
# snapshots of the repository, a judge from another model family picks the simplest correct answer,
# a refuter must disprove what survives. Harness-agnostic: needs only bash, git and python3.
set -u
# The whole body lives in main() so bash parses the file completely before running it: editing the
# skill while a `quorum wait` is in flight must not break the running process.
main() {
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/common.sh"
source "$QR_SKILL_DIR/bin/lib/finalize.sh"
source "$QR_SKILL_DIR/bin/lib/usage.sh"
PROFILE_MARK="<!-- quorum: project profile -->"

usage() {
  cat <<'USAGE'
quorum — a council of models: independent answers, a judge, a refuter

  quorum doctor                         which backends are available
  quorum config [set KEY VALUE]         effective advisors / judge / models and the override file
  quorum brief [--out FILE]             brief template (+ "## Quorum" section of AGENTS.md/CLAUDE.md)
  quorum consult --brief FILE [options] start the council in the background; prints the run path
      --stage plan|stuck|done           plan: one solution each + judge (default); stuck: diagnose a failure + judge;
                                        done: acceptance — checks, blocking findings only, refuter
      --advisors NAME[,NAME]            default QUORUM_ADVISORS (codex,grok,glm); "name:variant" runs one backend twice
      --judge NAME                      default QUORUM_JUDGE (fable); not used at stage done
      --plan FILE                       document (plan, design) put into the snapshot and the prompt
      --base REF                        stage done: diff base (default: merge-base with main/master)
      --refute | --no-refute            refuter after the verdict (default: on for plan and done, off for stuck)
      --timeout SEC                     per advisor / refuter (default QUORUM_TIMEOUT)
      --deps copy|hardlink|symlink|none how ignored dependencies get into snapshots (default QUORUM_DEPS)
      --link PATH                       extra dependency path (repeatable)
  quorum wait [RUN] [--max SEC]         wait up to SEC for the verdict; first line "STATE: ready" or "STATE: running"
                                        (exit code is 0 in both cases; call again while running)
  quorum status [RUN]                   jobs and progress
  quorum advance [RUN]                  one step of the state machine (runs by itself when a job ends; wait repeats it)
  quorum ask RUN JOB "question"         continue an advisor's session (a focused follow-up); prints the answer
  quorum feedback RUN "note"            the implementer's note: what helped, what was accepted or rejected
  quorum digest [--since DATE]          usage journal + notes as Markdown (for a retrospective)
  quorum logs RUN JOB                   stderr tail and progress of one job
  quorum runs                           runs of the current project
  quorum clean [RUN|--all] [--force]    remove worktrees and the run directory (refuses while jobs run unless --force)
USAGE
}

lang_dir() { [ -d "$QR_SKILL_DIR/prompts/$QUORUM_LANG" ] || die "unknown language '$QUORUM_LANG'"; printf '%s' "$QR_SKILL_DIR/prompts/$QUORUM_LANG"; }
meta_get() { python3 -c 'import json,sys; v=json.load(open(sys.argv[1])).get(sys.argv[2]); print("" if v is None else v if not isinstance(v,list) else " ".join(v))' "$1/meta.json" "$2" 2>/dev/null; }

cmd_doctor() {
  local b out rc
  printf '%-9s %s\n' "BACKEND" "STATUS"
  for b in $QR_ALL_BACKENDS; do
    out="$(bash "$QR_SKILL_DIR/bin/backends/$b.sh" check 2>&1)"; rc=$?
    printf '%-9s %s %s\n' "$b" "$([ $rc -eq 0 ] && echo '✓' || echo '✗')" "$out"
  done
  echo; echo "advisors: $QUORUM_ADVISORS · judge: $QUORUM_JUDGE (quorum config)"
}

cmd_config() {
  [ -z "${QR_CODEX_PARENT_ERROR:-}" ] || warn "Codex launch blocked: $QR_CODEX_PARENT_ERROR"
  if [ "${1:-}" = "set" ]; then
    [ $# -eq 3 ] || die "config set KEY VALUE"
    case " $QR_CONFIG_KEYS " in *" $2 "*) ;; *) die "unknown key $2; allowed: $QR_CONFIG_KEYS";; esac
    mkdir -p "$(dirname "$QR_CONFIG_FILE")"; touch "$QR_CONFIG_FILE"
    grep -vE "^\s*$2=" "$QR_CONFIG_FILE" > "$QR_CONFIG_FILE.tmp" || true
    printf '%s=%s\n' "$2" "$3" >> "$QR_CONFIG_FILE.tmp"; mv "$QR_CONFIG_FILE.tmp" "$QR_CONFIG_FILE"
    echo "written to $QR_CONFIG_FILE: $2=$3"; return
  fi
  echo "override file: $QR_CONFIG_FILE $([ -f "$QR_CONFIG_FILE" ] && echo '(exists)' || echo '(absent — skill defaults apply)')"
  echo "precedence: environment variable → current Codex parent (model/effort only) → file → skill default"
  local k
  for k in $QR_CONFIG_KEYS; do printf '  %-22s %s\n' "$k" "${!k}"; done
}

append_profile() { # append_profile ROOT FILE — add the project profile section (idempotent via marker)
  local root="$1" file="$2" src
  grep -qF "$PROFILE_MARK" "$file" 2>/dev/null && return 0
  src="$(py profile "$root" --source 2>/dev/null)" || return 1
  { echo; echo "## Профиль проекта (из $src)"; echo "$PROFILE_MARK"; echo; py profile "$root"; } >> "$file"
  echo "$src"
}

cmd_brief() {
  local out=""
  while [ $# -gt 0 ]; do case "$1" in --out) out="$2"; shift 2;; *) die "brief: unknown option $1";; esac; done
  local tmp; tmp="$(mktemp)"; cp "$(lang_dir)/brief.md" "$tmp"
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  local from=""; [ -z "$root" ] || from="$(append_profile "$root" "$tmp" || true)"
  [ -z "$from" ] || warn "project profile appended from $from"
  if [ -n "$out" ]; then mv "$tmp" "$out"; echo "$out"; else cat "$tmp"; rm -f "$tmp"; fi
}

write_header() { # write_header RUN STAGE BASE HEAD ROOT LINKS DEPS
  local run="$1" stage="$2" base="$3" head="$4" root="$5" links="$6" deps="$7"
  {
    echo "# Служебная вводная (сгенерирована quorum)"; echo
    echo "- Ты работаешь в одноразовом снапшоте репозитория: \`\$PWD\` (detached git worktree на коммит \`${head:0:12}\`)."
    echo "  Всё, что ты здесь меняешь, никуда не попадает. Можно запускать тесты, писать одноразовые скрипты, править код ради проверки."
    echo "- Оригинальное рабочее дерево: \`$root\` — НЕ трогай его и ничего туда не пиши."
    case "$deps" in
      copy)     [ -n "$links" ] && echo "- Зависимости ($links) СКОПИРОВАНЫ в снапшот: тесты запускай прямо здесь. В docker монтируй ЭТОТ каталог (\`\$PWD\`), а не оригинал." ;;
      hardlink) [ -n "$links" ] && echo "- Зависимости ($links) — хардлинки на оригинал: НЕ редактируй их файлы на месте. Тесты запускай здесь; в docker монтируй \`\$PWD\`." ;;
      symlink)  [ -n "$links" ] && echo "- Зависимости ($links) — симлинки в оригинал (не менять содержимое). Внутри docker они не разрешатся." ;;
      none)     echo "- Игнорируемые зависимости (vendor, node_modules, .venv) в снапшот НЕ перенесены: установи их сам или запускай проверки так, как описано во вводной." ;;
    esac
    echo "- Никаких \`git push\`, коммитов в чужие ветки и сетевых действий с чужими системами."
    echo "- Никто не ответит на вопросы: если чего-то не хватает, напиши, чего именно, и отвечай по тому, что есть."
    case "$stage" in
      plan)  echo "- Этап: **до кода**. Снапшот — текущее состояние репозитория; кода задачи в нём ещё нет (или есть только начало)." ;;
      stuck) echo "- Этап: **сбой в работе**. Снапшот включает незакоммиченные правки исполнителя." ;;
      done)  echo "- Этап: **приёмка**. Снапшот включает незакоммиченные правки исполнителя. База сравнения: \`$base\`; изменения: \`git diff $base...HEAD\`."
             echo "- Затронутые файлы:"; echo '```'; git -C "$run/_snapshot_ref" diff --stat "$base...HEAD" 2>/dev/null | tail -n 60; echo '```' ;;
    esac; echo
  } > "$run/header.md"
}

# new_job RUN NAME BACKEND ROLE MODE PROMPT_FILE SNAP(new|none|link:PARENT) TIMEOUT EFFORT
new_job() {
  local run="$1" name="$2" backend="$3" role="$4" mode="$5" prompt="$6" snap="$7" timeout="$8" effort="$9"
  local d="$run/$name"; mkdir -p "$d"
  bash "$QR_SKILL_DIR/bin/backends/${backend%%:*}.sh" format > "$d/format" 2>/dev/null || { warn "no backend $backend — skipping $name"; rm -rf "$d"; return 1; }
  echo "$backend" > "$d/backend"; echo "$role" > "$d/role"; echo "$mode" > "$d/mode"; echo "$timeout" > "$d/timeout"
  cp "$prompt" "$d/prompt.md"
  local root; root="$(cat "$run/project_root")"
  case "$snap" in
    new)   make_worktree "$root" "$(meta_get "$run" snapshot_commit)" "$d/snapshot" "$(cat "$run/deps")" $(cat "$run/links")
           [ ! -f "$run/plan.md" ] || cp "$run/plan.md" "$d/snapshot/plan.md"
           uuid > "$d/session" ;;
    bare)  make_worktree "$root" "$(meta_get "$run" snapshot_commit)" "$d/snapshot" none
           uuid > "$d/session" ;;
    link:*) local parent="${snap#link:}"; echo "$parent" > "$d/parent"
           ln -s "$run/$parent/snapshot" "$d/snapshot"; cp "$run/$parent/session" "$d/session"
           cp "$run/$parent/codex-settings.json" "$d/" 2>/dev/null || true ;;
  esac
  echo queued > "$d/status"
  QR_EFFORT="$effort" setsid nohup bash "$QR_SKILL_DIR/bin/lib/launch.sh" "$run" "$name" >/dev/null 2>&1 < /dev/null 9>&- &
  echo $! > "$d/pid"
}

cmd_consult() {
  local brief="" stage="plan" advisors="$QUORUM_ADVISORS" judge="$QUORUM_JUDGE" plan="" base="" refute="" timeout="$QUORUM_TIMEOUT" deps="$QUORUM_DEPS"
  local links="$QR_DEFAULT_LINKS" extra_links=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --brief) brief="$2"; shift 2;; --stage) stage="$2"; shift 2;; --advisors) advisors="$2"; shift 2;; --judge) judge="$2"; shift 2;;
      --plan) plan="$2"; shift 2;; --base) base="$2"; shift 2;; --refute) refute=1; shift;; --no-refute) refute=0; shift;;
      --timeout) timeout="$2"; shift 2;; --deps) deps="$2"; shift 2;; --link) extra_links="$extra_links $2"; shift 2;;
      -h|--help) usage; exit 0;; *) die "consult: unknown option $1";;
    esac
  done
  [ -n "$brief" ] && [ -f "$brief" ] || die "consult: --brief FILE is required (template: quorum brief --out brief.md)"
  case "$stage" in plan|stuck|done) ;; *) die "consult: --stage plan|stuck|done";; esac
  case "$deps" in copy|hardlink|symlink|none) ;; *) die "consult: --deps copy|hardlink|symlink|none";; esac
  [ -z "$plan" ] || [ -f "$plan" ] || die "consult: plan file not found: $plan"
  if [ -z "$refute" ]; then case "$stage" in stuck) refute=0;; *) refute=1;; esac; fi
  [ "$stage" != "done" ] || refute=1
  local pdir; pdir="$(lang_dir)"
  local list="${advisors//,/ }" a fams=""
  for a in $list; do
    bash "$QR_SKILL_DIR/bin/backends/${a%%:*}.sh" format >/dev/null 2>&1 || die "consult: unknown backend $a"
    fams="$fams $(family_of "$a")"
  done
  if [ "$stage" != "done" ]; then
    bash "$QR_SKILL_DIR/bin/backends/${judge%%:*}.sh" format >/dev/null 2>&1 || die "consult: unknown judge backend $judge"
    case " $fams " in *" $(family_of "$judge") "*) warn "judge $judge shares a model family with an advisor; its verdict on that advisor is less independent";; esac
  fi

  local root name run snap_commit
  root="$(proj_root)"; name="$(basename "$root")"
  mkdir -p "$QR_RUNS"
  run="$(mktemp -d "$QR_RUNS/$name-$(date +%Y%m%d-%H%M%S)-XXXX")"
  echo "$root" > "$run/project_root"; echo "$timeout" > "$run/timeout"; echo "$deps" > "$run/deps"
  echo "$judge" > "$run/judge"; echo "$refute" > "$run/refute"
  printf '%s\n' $links $extra_links > "$run/links"
  snap_commit="$(snapshot_commit "$root")"
  if [ "$stage" = "done" ]; then
    base="$(detect_base "$root" "$base")" || die "consult: no base found (main/master); pass --base REF"
    local mb; mb="$(git -C "$root" merge-base "$base" "$snap_commit")"
    [ "$mb" != "$snap_commit" ] || die "consult: no changes between $base and the working tree — nothing to accept"
    base="$mb"
  fi
  make_worktree "$root" "$snap_commit" "$run/_snapshot_ref" none
  write_header "$run" "$stage" "$base" "$snap_commit" "$root" "$(echo $links $extra_links)" "$deps"
  remove_worktree "$root" "$run/_snapshot_ref"

  cp "$brief" "$run/brief.md"
  local from; from="$(append_profile "$root" "$run/brief.md" || true)"
  [ -z "$from" ] || warn "project profile appended to the brief from $from"
  [ -z "$plan" ] || cp "$plan" "$run/plan.md"
  { cat "$pdir/$stage.md"; echo; echo "---"; echo; cat "$run/header.md"; echo; cat "$run/brief.md"; echo
    [ -z "$plan" ] || { echo "---"; echo; echo "# Документ (plan.md, лежит и в корне снапшота)"; echo; cat "$plan"; echo; }
  } > "$run/prompt.md"

  python3 - "$run" "$name" "$stage" "$base" "$snap_commit" "$list" "$judge" "$refute" "$(usage_harness)" <<'PY'
import json, sys, datetime
run, name, stage, base, snap, lst, judge, refute, harness = sys.argv[1:10]
json.dump({"project": name, "stage": stage, "base": base, "snapshot_commit": snap, "advisors": lst.split(),
           "judge": judge if stage != "done" else None, "refute": refute == "1", "harness": harness,
           "started": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")},
          open(f"{run}/meta.json", "w"), ensure_ascii=False, indent=1)
PY
  for a in $list; do new_job "$run" "$a" "$a" advisor run "$run/prompt.md" new "$timeout" "$QUORUM_ADVISOR_EFFORT" || true; done
  [ -n "$(run_jobs "$run" advisor)" ] || die "consult: no advisor could be started"
  usage_log consult run="$(basename "$run")" stage="$stage" advisors="$(echo $list | tr ' ' ',')" judge="$judge" refute="$refute" \
    profile="$(py profile "$root" --source 2>/dev/null || echo none)" plan="${plan:+1}"
  echo "$run"
  local dr; dr="$(deps_report "$root" $links $extra_links)"; [ -z "$dr" ] || echo "deps ($deps): $dr" >&2
  echo "started advisors: $list$( [ "$stage" != "done" ] && echo " · judge: $judge")$( [ "$refute" = 1 ] && echo " · refuter: on")" >&2
  echo "next: quorum wait $run --max 110   (repeat until exit 0, then read $run/verdict.md)" >&2
}

reap_dead() { # a wrapper that vanished without a final status → finalize from what is on disk
  local j
  for j in $(run_jobs "$1"); do
    job_busy "$1" "$j" || continue
    [ -f "$1/$j/pid" ] && kill -0 "$(cat "$1/$j/pid")" 2>/dev/null && continue
    finalize_job "$1" "$j" died
  done
}

busy_jobs() { local j; for j in $(run_jobs "$1"); do job_busy "$1" "$j" && printf '%s ' "$j"; done; }
done_jobs() { local j; for j in $(run_jobs "$1" "$2"); do [ "$(status_of "$1" "$j")" = "done" ] && printf '%s ' "$j"; done; }
elapsed() { local s e a b; s="$(cat "$1/started" 2>/dev/null)" || { echo "—"; return; }; e="$(cat "$1/finished" 2>/dev/null || now_iso)"; a=$(date -d "$s" +%s); b=$(date -d "$e" +%s); printf '%dm%02ds' $(( (b-a)/60 )) $(( (b-a)%60 )); }

cmd_status() {
  local run; run="$(resolve_run "${1:-}")"; reap_dead "$run"
  echo "run: $run ($(meta_get "$run" stage))"
  local j d st
  for j in $(run_jobs "$run"); do
    d="$run/$j"; st="$(status_of "$run" "$j")"
    [ ! -f "$d/partial" ] || st="$st($(head -c 50 "$d/partial" | tr -d '\n'))"
    printf '%-24s %-9s %-8s %s\n' "$j" "$st" "$(elapsed "$d")" "$(py progress "$(cat "$d/format")" "$d/raw" 2>/dev/null)"
  done
  [ ! -f "$run/verdict.md" ] || echo "verdict: $run/verdict.md"
}

write_verdict() { # verdict.md appears atomically: readers poll for the file and must never see it half-written
  local run="$1"
  py summary "$run" > "$run/summary.json" 2>/dev/null || true
  py verdict "$run" > "$run/.verdict.tmp" && mv "$run/.verdict.tmp" "$run/verdict.md"
  usage_log verdict run="$(basename "$run")" stage="$(meta_get "$run" stage)" summary="@$run/summary.json"
  echo "$run/verdict.md"
}

# One step of the state machine. Exit 0 = verdict.md written, 3 = jobs running or just launched.
# Called by `wait`, by every job wrapper when its job ends (launch.sh) and by hand; the lock on the
# run keeps two callers from launching the same role twice. Jobs are spawned with fd 9 closed.
cmd_advance() {
  local run; run="$(resolve_run "${1:-}")"
  exec 9>"$run/.advance.lock"; flock -w 600 9 || { echo "advance: the run is locked by another caller"; return 3; }
  reap_dead "$run"
  [ ! -f "$run/verdict.md" ] || { echo "$run/verdict.md"; return 0; }
  local busy; busy="$(busy_jobs "$run")"
  [ -z "$busy" ] || { echo "running: $busy"; return 3; }
  local stage judge pdir timeout; stage="$(meta_get "$run" stage)"; judge="$(cat "$run/judge")"; pdir="$(lang_dir)"; timeout="$(cat "$run/timeout")"
  local done_adv; done_adv="$(done_jobs "$run" advisor)"
  if [ "$stage" = "done" ]; then
    if [ ! -f "$run/claims.json" ]; then
      [ -n "$done_adv" ] || { write_verdict "$run"; return 0; }
      py claims "$run" > /dev/null
      local refuters; refuters="$(python3 -c 'import json,sys; print(" ".join(sorted({c["refuter"] for c in json.load(open(sys.argv[1])) if c.get("refuter")})))' "$run/claims.json")"
      [ -n "$refuters" ] || { write_verdict "$run"; return 0; }
      local r tmp; tmp="$(mktemp)"
      for r in $refuters; do
        { cat "$run/header.md"; echo; py refute-prompt "$run" "refute-$r" "$pdir/refuter.md"; } > "$tmp"
        new_job "$run" "refute-$r" "$r" refuter run "$tmp" new "$timeout" "$QUORUM_ADVISOR_EFFORT" || true
      done; rm -f "$tmp"
      usage_log refute run="$(basename "$run")" refuters="$(echo $refuters | tr ' ' ',')" claims="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$run/claims.json")"
      echo "launched refuters: $refuters"; return 3
    fi
    write_verdict "$run"; return 0
  fi
  # plan | stuck
  local n; n="$(echo $done_adv | wc -w)"
  [ "$n" -ge 2 ] || { warn "fewer than two advisors answered — no judging, the verdict lists what there is"; write_verdict "$run"; return 0; }
  local rounds last; rounds="$(run_jobs "$run" judge | wc -l)"
  if [ "$rounds" -eq 0 ]; then
    py letters "$run" > /dev/null
    local tmp; tmp="$(mktemp)"; py judge-prompt "$run" 1 "$pdir/judge.md" > "$tmp"
    new_job "$run" judge-1 "$judge" judge run "$tmp" bare "$QUORUM_JUDGE_TIMEOUT" "$QUORUM_JUDGE_EFFORT" || { rm -f "$tmp"; write_verdict "$run"; return 0; }
    rm -f "$tmp"; usage_log judge run="$(basename "$run")" round=1; echo "launched judge-1 ($judge)"; return 3
  fi
  last="$run/judge-$rounds"
  local choice; choice="$(py judge-choice "$last/report.md" | python3 -c 'import json,sys; print(json.load(sys.stdin)["choice"])')"
  if [ "$(status_of "$run" "judge-$rounds")" = "done" ] && [ ! -f "$last/logged" ]; then
    py summary "$run" > "$run/summary.json" 2>/dev/null || true
    usage_log judge_done run="$(basename "$run")" round="$rounds" choice="$choice" summary="@$run/summary.json"; touch "$last/logged"
  fi
  if [ "$choice" = none ] && [ "$(status_of "$run" "judge-$rounds")" = "done" ]; then
    if [ "$rounds" -eq 1 ] && [ "${QUORUM_RETRY:-1}" -ge 1 ] && [ -z "$(run_jobs "$run" retry)" ]; then
      local a letter fb tmp; tmp="$(mktemp)"
      for a in $done_adv; do
        letter="$(python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); print(next((k for k,v in m.items() if v==sys.argv[2]), ""))' "$run/letters.json" "$a")"
        fb="$(py judge-choice "$last/report.md" | python3 -c 'import json,sys; print((json.load(sys.stdin)["feedback"] or {}).get(sys.argv[1], ""))' "$letter")"
        [ -n "$fb" ] || fb="Судья не принял ни одно решение. Перепроверь своё по коду и сократи его до необходимого."
        { echo "Судья прочитал решения советников и не выбрал ни одно. Его замечание к твоему решению:"; echo; echo "$fb"; echo
          echo "Переделай ответ с учётом замечания, в том же формате, целиком (это новый полный ответ, не дополнение). Если замечание неверно, скажи почему с уликой из кода. Сохрани ответ и в ANSWER.md."; } > "$tmp"
        new_job "$run" "retry-$a" "$a" retry ask "$tmp" "link:$a" "$timeout" "$QUORUM_ADVISOR_EFFORT" || true
      done; rm -f "$tmp"
      usage_log retry run="$(basename "$run")" n="$n"; echo "launched retry for: $done_adv"; return 3
    fi
    if [ "$rounds" -eq 1 ] && [ -n "$(run_jobs "$run" retry)" ]; then
      local tmp; tmp="$(mktemp)"; py judge-prompt "$run" 2 "$pdir/judge.md" > "$tmp"
      new_job "$run" judge-2 "$judge" judge run "$tmp" bare "$QUORUM_JUDGE_TIMEOUT" "$QUORUM_JUDGE_EFFORT" || { rm -f "$tmp"; write_verdict "$run"; return 0; }
      rm -f "$tmp"; usage_log judge run="$(basename "$run")" round=2; echo "launched judge-2 ($judge)"; return 3
    fi
  fi
  if [ "$choice" != none ] && [ "$(cat "$run/refute")" = 1 ] && [ -z "$(run_jobs "$run" refuter)" ]; then
    local winner; winner="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$run/letters.json" "$choice")"
    echo "$winner" > "$run/winner"
    local wf a r=""; wf="$(family_of "$winner")"
    for a in $done_adv; do [ "$(family_of "$a")" != "$wf" ] && { r="$a"; break; }; done
    [ -n "$r" ] || { [ "$(family_of "$judge")" != "$wf" ] && r="$judge"; }
    if [ -n "$r" ]; then
      local tmp; tmp="$(mktemp)"
      { cat "$run/header.md"; echo; py refute-prompt "$run" "refute-$r" "$pdir/refuter.md"; } > "$tmp"
      new_job "$run" "refute-$r" "$r" refuter run "$tmp" new "$timeout" "$QUORUM_ADVISOR_EFFORT" && { rm -f "$tmp"; usage_log refute run="$(basename "$run")" refuters="$r"; echo "launched refuter ($r) on the winner $winner"; return 3; }
      rm -f "$tmp"
    else warn "no backend from another family to refute $winner — skipped"; fi
  fi
  [ "$choice" = none ] || echo "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$run/letters.json" "$choice")" > "$run/winner"
  write_verdict "$run"; return 0
}

cmd_wait() {
  local run="" interval=15 max="${QUORUM_WAIT_MAX:-110}"
  while [ $# -gt 0 ]; do case "$1" in --interval) interval="$2"; shift 2;; --max) max="$2"; shift 2;; *) run="$1"; shift;; esac; done
  run="$(resolve_run "$run")"
  local t0; t0=$(date +%s)
  while :; do
    local out rc; out="$(cmd_advance "$run")"; rc=$?
    if [ "$rc" -eq 0 ]; then echo "STATE: ready — $out"; cmd_status "$run"; return 0; fi
    case "$out" in launched*) echo "$out";; esac
    if [ $(( $(date +%s) - t0 )) -ge "$max" ]; then
      echo "STATE: running — not an error; verdict.md does not exist yet, do not read or clean the run; call again: quorum wait $run --max $max"; cmd_status "$run"; return 0
    fi
    sleep "$interval"
  done
}

cmd_ask() {
  [ $# -ge 3 ] || die "ask RUN JOB \"question\""
  local run; run="$(resolve_run "$1")"; local j="$2"; shift 2; local msg="$*"
  local d="$run/$j"; [ -d "$d" ] || die "no job $j in this run"
  export QR_RUN="$run" QR_JOB="$j" QR_DIR="$d" QR_SNAPSHOT="$d/snapshot" QR_PROMPT="$d/prompt.md"
  export QR_PROJ_ROOT="$(cat "$run/project_root")" QR_TIMEOUT="$(cat "$run/timeout")" QR_EFFORT="$QUORUM_ADVISOR_EFFORT"
  local n; n=$(ls "$d"/ask-*.md 2>/dev/null | wc -l); n=$((n+1))
  usage_log ask run="$(basename "$run")" job="$j" n="$n"
  local raw="$d/ask-$n.raw"
  local backend; backend="$(cat "$d/backend")"
  timeout -k 30 "$QR_TIMEOUT" bash "$QR_SKILL_DIR/bin/backends/${backend%%:*}.sh" ask "$msg" > "$raw" 2>>"$d/stderr.log"
  { echo "## Вопрос"; echo; echo "$msg"; echo; echo "## Ответ ($j)"; echo; py report "$(cat "$d/format")" "$raw"; } | tee "$d/ask-$n.md"
}

cmd_feedback() {
  [ $# -ge 2 ] || die 'feedback RUN "note"'
  local run; run="$(resolve_run "$1")"; shift; local text="$*"
  [ -n "$text" ] || die "feedback: the note is empty"
  [ -f "$run/verdict.md" ] || die "feedback: no verdict yet ($run/verdict.md does not exist). A note is about what the verdict gave; run: quorum wait $run"
  printf '%s\n' "$text" > "$run/feedback.md"
  local harness; harness="$(meta_get "$run" harness)"; [ -n "$harness" ] || harness="$(usage_harness)"
  python3 - "$QR_HOME/feedback.jsonl" "$(basename "$run")" "$(meta_get "$run" project)" "$harness" "$(meta_get "$run" stage)" "$run/feedback.md" <<'PY'
import json, sys, datetime
path, run, project, harness, stage, note = sys.argv[1:7]
rec = {"ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "run": run, "stage": stage,
       "project": project, "harness": harness, "note": open(note, encoding="utf-8").read().strip()}
with open(path, "a", encoding="utf-8") as fh: fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
PY
  usage_log feedback run="$(basename "$run")" chars="$(wc -c < "$run/feedback.md")"
  echo "saved: $run/feedback.md (and $QR_HOME/feedback.jsonl)"
}

cmd_digest() { local since=""; [ "${1:-}" != "--since" ] || since="$2"; py digest "$QR_HOME" ${since:+--since "$since"}; }
cmd_logs() { local run; run="$(resolve_run "$1")"; local d="$run/$2"; echo "--- stderr (tail) ---"; tail -n 30 "$d/stderr.log" 2>/dev/null; echo "--- progress ---"; py progress "$(cat "$d/format")" "$d/raw"; }
cmd_runs() { ls -1d "$QR_RUNS/$(proj_name)"-* 2>/dev/null || echo "no runs"; }

# Files created by tests inside docker belong to root and survive rm: delete them through a container.
rm_stubborn() { # rm_stubborn DIR
  rm -rf "$1" 2>/dev/null; [ -e "$1" ] || return 0
  if command -v docker >/dev/null 2>&1; then
    docker run --rm -v "$1:/target" alpine sh -c 'rm -rf /target/* /target/.[!.]* 2>/dev/null; true' >/dev/null 2>&1
    rm -rf "$1" 2>/dev/null
  fi
  [ ! -e "$1" ] || { warn "could not remove $1 (files owned by another user; try: sudo rm -rf '$1')"; return 1; }
}

cmd_clean() {
  local root; root="$(proj_root)"; local targets=() force="" arg=""
  while [ $# -gt 0 ]; do case "$1" in --force) force=1; shift;; *) arg="$1"; shift;; esac; done
  if [ "$arg" = "--all" ]; then mapfile -t targets < <(ls -1d "$QR_RUNS/$(basename "$root")"-* 2>/dev/null)
  else targets=("$(resolve_run "$arg")"); fi
  local run j
  for run in "${targets[@]}"; do
    reap_dead "$run"
    local busy; busy="$(busy_jobs "$run")"
    if [ -n "$busy" ] && [ -z "$force" ]; then
      echo "not removed: $run — still running: $busy. Wait for STATE: ready (quorum wait $run) or pass --force to kill them."; continue
    fi
    for j in $(run_jobs "$run"); do
      [ -f "$run/$j/pid" ] && kill "$(cat "$run/$j/pid")" 2>/dev/null
      [ -L "$run/$j/snapshot" ] && rm -f "$run/$j/snapshot"
      remove_worktree "$root" "$run/$j/snapshot"
    done
    rm_stubborn "$run" && echo "removed $run"; usage_log clean run="$(basename "$run")" forced="${force:-0}"
  done
  git -C "$root" worktree prune 2>/dev/null || true
}

case "${1:-}" in
  doctor) shift; cmd_doctor "$@";;
  config) shift; cmd_config "$@";;
  brief) shift; cmd_brief "$@";;
  consult) shift; cmd_consult "$@";;
  status) shift; cmd_status "$@";;
  wait) shift; cmd_wait "$@";;
  advance) shift; cmd_advance "$@";;
  ask) shift; cmd_ask "$@";;
  feedback) shift; cmd_feedback "$@";;
  digest) shift; cmd_digest "$@";;
  logs) shift; cmd_logs "$@";;
  runs) shift; cmd_runs "$@";;
  clean) shift; cmd_clean "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (quorum --help)";;
esac
}
main "$@"
exit $?
